NODE_ENV=production
PORT=3080
APP_BASE_URL=http://localhost:3080
APP_SECRET=replace-with-32-plus-random-bytes
APP_BASIC_AUTH_USER=
APP_BASIC_AUTH_PASSWORD=
DATABASE_URL=postgres://orders:orders@db:5432/orders
POLL_INTERVAL_MINUTES=15
POLL_OVERLAP_MINUTES=30
INITIAL_LOOKBACK_DAYS=30
POLL_ON_START=true

# Etsy Open API v3
ETSY_ENABLED=false
ETSY_CLIENT_ID=
ETSY_CLIENT_SECRET=
ETSY_SHOP_ID=
ETSY_SCOPES=transactions_r listings_r listings_w
ETSY_REDIRECT_URI=http://localhost:3080/auth/etsy/callback

# Shopify Admin API. For a single owned store, a custom app token is simplest.
SHOPIFY_ENABLED=false
SHOPIFY_SHOP_DOMAIN=your-shop.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-04

# Amazon SP-API
AMAZON_ENABLED=false
AMAZON_ORDERS_API_VERSION=2026-01-01
AMAZON_AUTH_MODE=private
AMAZON_APPLICATION_ID=
AMAZON_SELLER_CENTRAL_URL=https://sellercentral-europe.amazon.com
AMAZON_AUTH_VERSION=
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_AWS_ACCESS_KEY_ID=
AMAZON_AWS_SECRET_ACCESS_KEY=
AMAZON_REGION_GROUP=eu
AMAZON_MARKETPLACE_IDS=de:A1PA6795UKMFR9,fr:A13V1IB3VIYZZH,it:APJ6JRA9NG5V4,es:A1RKKUPIHCS9T
AMAZON_REDIRECT_URI=http://localhost:3080/auth/amazon/callback
AMAZON_FETCH_ADDRESS=false

# GLS shipping labels
GLS_API_URL=https://api.mygls.sk/
GLS_USERNAME=
GLS_PASSWORD=
GLS_CLIENT_NUMBER=
GLS_DEFAULT_COUNTRY_ISO=SK
GLS_PICKUP_NAME=
GLS_PICKUP_CONTACT_NAME=
GLS_PICKUP_CONTACT_PHONE=
GLS_PICKUP_CONTACT_EMAIL=
GLS_PICKUP_STREET=
GLS_PICKUP_HOUSE_NUMBER=
GLS_PICKUP_HOUSE_NUMBER_INFO=
GLS_PICKUP_CITY=
GLS_PICKUP_ZIP_CODE=
GLS_PICKUP_COUNTRY_ISO=SK

# Slovenska posta labels
POSTA_BASE_URL=https://mojezasielky.posta.sk/integration/rest/v1
POSTA_USER_ID=
POSTA_API_KEY=
POSTA_REGISTERED_LETTER_CATEGORY=r
POSTA_REGISTERED_LETTER_WEIGHT_KG=0.5
POSTA_REGISTERED_LETTER_CUSTOMS_VALUE_EUR=10.00
POSTA_PARCEL_CATEGORY=b
POSTA_PARCEL_WEIGHT_KG=2.3
POSTA_PARCEL_CUSTOMS_VALUE_EUR=34.00
POSTA_RECEPTION_METHOD=post
POSTA_PAYMENT_TYPE=up
POSTA_CONTRACT=true
POSTA_OWN_PARCEL_NUMBERS=false
POSTA_SKIP_PARCEL_NUMBERS=false
POSTA_PACKAGING=standard
POSTA_CUSTOMS_CATEGORY=gift
POSTA_CUSTOMS_DESCRIPTION=Toys and games
POSTA_CUSTOMS_TARIFF_NUMBER=950300
POSTA_CUSTOMS_ORIGIN_COUNTRY=SK
POSTA_SENDER_NAME=
POSTA_SENDER_ORGANIZATION=
POSTA_SENDER_STREET=
POSTA_SENDER_CITY=
POSTA_SENDER_ZIP=
POSTA_SENDER_COUNTRY=SK
POSTA_SENDER_PHONE=
POSTA_SENDER_EMAIL=

# Optional Docker host Wi-Fi address for phone QR when desktop uses localhost.
# No certificate installation, domain or Tailscale is needed for local HTTP.
MOMS_LAN_ADDRESS=
